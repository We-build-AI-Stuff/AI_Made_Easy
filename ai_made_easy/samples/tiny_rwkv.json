{
  "schema_version": 1,
  "name": "tiny_rwkv",
  "meta": {
    "title": "Text \u2014 Tiny RWKV Language Model",
    "description": "A small RWKV language model: token embeddings, two RWKV blocks (time mixing, a linear-attention recurrence with a learned decay, and channel mixing) and a final LayerNorm. It writes toy sentences byte by byte. Swap Synthetic Text for a Text Corpus to train on your own writing."
  },
  "nodes": [
    {
      "id": "input",
      "type": "core.input",
      "params": {
        "shape": "64",
        "dtype": "int64"
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "embed",
      "type": "core.embedding",
      "params": {
        "num_embeddings": 256,
        "embedding_dim": 128
      },
      "position": [
        200,
        0
      ]
    },
    {
      "id": "rwkv",
      "type": "seq.rwkv7",
      "params": {
        "layers": 2,
        "head_size": 32
      },
      "position": [
        400,
        0
      ]
    },
    {
      "id": "norm",
      "type": "core.layer_norm",
      "params": {
        "normalized_dims": "last"
      },
      "position": [
        600,
        0
      ]
    },
    {
      "id": "lm_head",
      "type": "core.dense",
      "params": {
        "units": 256,
        "bias": false
      },
      "position": [
        800,
        0
      ]
    },
    {
      "id": "output",
      "type": "core.output",
      "params": {},
      "position": [
        1000,
        0
      ]
    },
    {
      "id": "text",
      "type": "data.synthetic_text",
      "params": {
        "n_sentences": 4000,
        "seed": 0,
        "val_fraction": 0.1
      },
      "position": [
        0,
        240
      ]
    },
    {
      "id": "optimizer",
      "type": "train.adamw",
      "params": {
        "lr": 0.001
      },
      "position": [
        200,
        240
      ]
    },
    {
      "id": "perplexity",
      "type": "eval.perplexity",
      "params": {},
      "position": [
        400,
        240
      ]
    },
    {
      "id": "trainer",
      "type": "train.trainer",
      "params": {
        "epochs": 30,
        "batch_size": 64,
        "device": "auto"
      },
      "position": [
        600,
        240
      ]
    }
  ],
  "edges": [
    {
      "from": "input/out",
      "to": "embed/in"
    },
    {
      "from": "embed/out",
      "to": "rwkv/in"
    },
    {
      "from": "rwkv/out",
      "to": "norm/in"
    },
    {
      "from": "norm/out",
      "to": "lm_head/in"
    },
    {
      "from": "lm_head/out",
      "to": "output/in"
    }
  ]
}
